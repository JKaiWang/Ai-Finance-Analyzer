FINNHUB_API_KEY=

# Upstream resilience and process-local cache settings.
FINSIGHT_UPSTREAM_RETRIES=2
FINSIGHT_UPSTREAM_BACKOFF_SECONDS=0.25
FINSIGHT_HTTP_TIMEOUT_SECONDS=10
FINSIGHT_TICKER_CACHE_TTL=60
FINSIGHT_STOCK_CACHE_TTL=300
FINSIGHT_NEWS_CACHE_TTL=900
FINSIGHT_CACHE_MAX_ENTRIES=256

# API security settings.
FINSIGHT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FINSIGHT_RATE_LIMIT_REQUESTS=120
FINSIGHT_RATE_LIMIT_WINDOW_SECONDS=60
